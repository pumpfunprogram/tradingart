# ---- required ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 32+ random chars: signs session cookies and one-time nonces (openssl rand -base64 48)
SESSION_SECRET=
# From the worker's `npm run gen-seal-key`. PUBLIC half is required.
# SECRET half is required on the website too, so a signed-in user can copy their vault key from the dashboard.
VAULT_SEAL_PUBLIC=
VAULT_SEAL_SECRET=
# Your public domain, no scheme (used in the sign-in message and checked on verify), e.g. art.example.com
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# ---- recommended ----
# Paid RPC for balance reads (a free one works for light use)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: enables WalletConnect-based wallets (Trust, Rainbow, Exodus, ... ) from cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=
# Open live-mode controls on the site. Must ALSO be enabled on the worker with LIVE_TRADING_ENABLED=true.
# Leave false until you have audited the setup and checked the legal side.
LIVE_ENABLED=false
# Telegram bot username (without @) for the "Link Telegram" button
NEXT_PUBLIC_TG_BOT=
